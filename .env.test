# APP
APP_PORT=3000
APP_CORS_ORIGIN=http://localhost:3000

# Auth
BCRYPT_ROUNDS=4
JWT_SECRET=e2e-access-secret-that-is-long-enough-01
JWT_REFRESH_SECRET=e2e-refresh-secret-that-is-long-enough-1
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth cookies
JWT_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token

# RabbitMQ
# RABBITMQ_URL comes from the RabbitMQ testcontainer, it is not static.
RABBITMQ_EXCHANGE_NAME=myfintracker.events.e2e
RABBITMQ_EXCHANGE_TYPE=topic

# Database
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD and DB_NAME come from the
# PostgreSQL testcontainer, they are not static.
DB_MIGRATIONS_RUN=true
